# Copy to .env and fill in.  .env is git-ignored — never commit your key.
#
# Every value here matches a field in config/settings.py and can also be
# exported as a plain environment variable instead.

# ── DeepSeek (https://platform.deepseek.com) — required unless --no-llm ──
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_THINKING=false          # true = reasoning mode (slower, ignores temperature)
# DEEPSEEK_MAX_WORKERS=8           # concurrent DeepSeek calls
# DEEPSEEK_TIMEOUT=180
# DEEPSEEK_MAX_RETRIES=4

# ── AI content curation (the default ingest mode) ────────────────────────
# One request carries at most CURATION_INPUT_TOKENS source tokens; longer
# sections are split at line/sentence boundaries and every part is processed.
# CURATION_INPUT_TOKENS=12000
# CURATION_MAX_OUTPUT_TOKENS=8000
# CURATION_CHUNK_MIN_TOKENS=40
# CURATION_CHUNK_TARGET_TOKENS=220
# CURATION_CHUNK_MAX_TOKENS=320    # content only; leave room for header/questions
# CURATION_MAX_WORKERS=4           # parallel requests within one page
# CURATION_STRICT_FACTS=true       # reject curated numbers absent from the source
# CURATION_RECONCILE=true          # cross-section duplicate/contradiction pass
# CURATION_RECONCILE_MAX_CHUNKS=300

# ── Vector store ────────────────────────────────────────────────────────
# Default keeps the Chroma index INSIDE this project: ingest writes to
# ./data/vector_store.  To share one index with the chatbot, point BOTH
# projects at the same path, e.g.
#   Windows :  C:/Projects/imiChat/data/vector_store
#   macOS   :  ../university-chatbot/data/vector_store
VECTOR_DB_PATH=./data/vector_store
CHROMA_COLLECTION=university_knowledge
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# EMBEDDING_DEVICE=cuda

# ── Retrieval UI (Flutter desktop app + local JSON API) ─────────────────
UI_HOST=127.0.0.1
UI_PORT=8765

# ── Crawling / deterministic fallback (defaults are fine) ────────────────
# CRAWL_DELAY=1.0
# CRAWL_DOC_PATTERNS=["/pub/"]
# CHUNK_MAX_TOKENS=300             # only with --no-llm
# EMBED_QUESTIONS=true             # add curated questions to the embedded text
