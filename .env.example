# Copy to .env and fill in.  .env is git-ignored — never commit your key.

# ── DeepSeek (https://platform.deepseek.com) — required unless --no-llm ──
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_THINKING=false
# DEEPSEEK_MAX_WORKERS=8

# ── Shared with the chatbot (C:\Projects\imiChat) — keep identical ──────
VECTOR_DB_PATH=C:/Projects/imiChat/data/vector_store
CHROMA_COLLECTION=university_knowledge
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# EMBEDDING_DEVICE=cuda

# ── Crawling / chunking (defaults are fine) ──────────────────────────────
# CRAWL_DELAY=1.0
# CRAWL_DOC_PATTERNS=["/pub/"]
# CHUNK_MAX_TOKENS=300
# EMBED_QUESTIONS=true
